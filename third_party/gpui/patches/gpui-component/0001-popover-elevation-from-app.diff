+// [kwikpaste patch 0001] The app can replace the hairline ring and the shadow layers of every
+// popup surface (menus, submenus, selects, popovers). shadcn's `rgb(0 0 0 / 0.1)` layers cannot
+// be seen on a dark surface, so a popup could not be told from the window behind it.
+static POPOVER_ELEVATION: std::sync::RwLock<Option<PopoverElevation>> =
+    std::sync::RwLock::new(None);
+
+/// The ring colour and the shadow layers the app wants on popup surfaces.
+#[derive(Clone, Debug)]
+pub struct PopoverElevation {
+    pub ring: Hsla,
+    pub shadows: Vec<BoxShadow>,
+}
+
+/// Replaces the ring and shadow of popup surfaces; `None` restores the built-in ones.
+pub fn set_popover_elevation(elevation: Option<PopoverElevation>) {
+    if let Ok(mut slot) = POPOVER_ELEVATION.write() {
+        *slot = elevation;
+    }
+}
